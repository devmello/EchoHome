<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only. android.permission.DUMP: only adb shell / system can send it. -->
        <receiver
            android:name="app.vesper.feature.alarm.AlarmDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.vesper.alarm.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
