# Copy to secrets.properties (git-ignored) and fill in what you use. Never commit the real file.
# Everything is optional: the app runs with none of it (sample data in debug builds).

# Voice assistant (Claude)
anthropic.apiKey=

# Calendars: comma-separated private iCal (.ics) URLs, e.g. Google Calendar's
# "Secret address in iCal format" or an iCloud public calendar link.
calendar.icsUrls=

# Photo frame (Immich)
immich.url=
immich.apiKey=

# Optional: Home Assistant, only for smart-home controls (Home screen, doorbell).
ha.url=
ha.token=

# Not needed: stocks use a free keyless API.
stocks.apiKey=
